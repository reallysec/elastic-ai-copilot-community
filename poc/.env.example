# ─── LLM Provider — single-provider mode (v0.x backward compat) ─────────
# 这一节只在 poc/llm_providers.yml 不存在时生效。要做多 provider failover/routing，
# 复制 poc/llm_providers.yml.example 为 poc/llm_providers.yml 并按需编辑——
# YAML 模式下下面这三个变量自动忽略。
LLM_API_KEY=your_volcengine_ark_api_key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=ep-xxxxxxxxxxxxxx-xxxxx

# ─── Multi-provider mode (v1.0+, 推荐生产) ────────────────────────────
# 当 poc/llm_providers.yml 存在时，下面变量名（api_key_env 字段引用）需要在这里赋值。
# 例如 yaml 里 api_key_env: ARK_API_KEY 那这里要有：
# ARK_API_KEY=your_ark_key
# OPENAI_API_KEY=your_openai_key
# VLLM_API_KEY=EMPTY                         # vLLM 通常接受任意字符串

# ─── Elasticsearch ────────────────────────────────────────────────
ES_URL=http://localhost:9200
# docker-compose.yml 默认关掉 xpack.security，留空即可
ES_USER=
ES_PASSWORD=

# ─── Kibana ───────────────────────────────────────────────────────
# 用于「在 Kibana Discover 中打开」按钮：解析 data view ID + 拼 Discover URL
KIBANA_URL=http://localhost:5601
# 网关从容器内访问 Kibana 的地址和用户浏览器能访问的地址不一定相同（容器名 vs
# 域名）。填了它，深链就用它拼给浏览器；留空则回落 KIBANA_URL。
# KIBANA_PUBLIC_URL=
# 客户自带、开了 xpack.security 的 Kibana：三选一。API key 优先，其次账号密码；
# 都留空则回落上面的 ES_USER / ES_PASSWORD。
# KIBANA_API_KEY=
# KIBANA_USER=
# KIBANA_PASSWORD=

# ─── License ──────────────────────────────────────────────────────
# License key 注入优先级：env > 文件 > UI 激活
# 1) env override（仅 CI / 测试，留空即跳过）
# RST_LICENSE_KEY=<base64.base64>
# 2) 持久化文件路径，默认 ./license.key（生产主路径）
# RST_LICENSE_FILE=./license.key

# RSA 公钥（验签用，由销售提供）。二选一：
#   - 直接放 PEM 字符串到 env：
# RST_LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
#   - 或指向 PEM 文件路径，默认 ./keys/license_public.pem
# RST_LICENSE_PUBLIC_KEY_PATH=./keys/license_public.pem

# AES-256 共享密钥（hex 字符串，64 字符）。由销售提供。
RST_LICENSE_AES_KEY=

# License Server（心跳上报地址）
LICENSE_SERVER_URL=http://localhost:8080

# Server GUID 持久化文件（默认 ./server_guid，首次启动自动生成 UUID v4）
# RST_SERVER_GUID_FILE=./server_guid

# App 版本（心跳上报字段；不改也行）
# APP_VERSION=0.3.0-dev

# 未激活模式每日 /api/generate /api/execute /api/explain-log /api/investigate-alert 调用上限
# 默认 5（适合"路过试用"演示场景）；开发期 / 内部测试建议 200+ 避免频繁卡额度
# RST_TRIAL_DAILY_LIMIT=200

# 字段脱敏强制模式（cloud / private / airgapped）
# 不设则按 license tier 自动选择：airgapped > private > cloud（默认 cloud 最安全）
# RST_MASKING_MODE=cloud

# ─── v0.9.1 试点 ready 加固 ───────────────────────────────────────
# 共享密钥：Kibana 插件 → Gateway 之间的 shared-secret 认证。
# 设置后所有 /api/* （除健康检查 / license 端点）必须带 X-RST-Gateway-Token 头。
# 不设 = 关闭认证（仅用于 dev / 单机演示，生产强烈建议设）
# RST_GATEWAY_SHARED_SECRET=change-me-to-a-long-random-string

# 索引白名单（glob 模式，逗号分隔）。用户问题指向白名单外的索引会 403。
# 不设 = 不限制（dev 默认）。生产强烈建议设。
# RST_INDEX_WHITELIST=logs-*,metrics-*,kibana_sample_*

# —— Agentic 告警调查（/api/investigate-alert）——
# 默认【开启】：LLM 通过 es_search 工具自主多轮检索 ES 收集证据再下结论。
# 显式关闭走单步旧路径：RST_AGENTIC_INVESTIGATE=0
# 需模型支持 function-calling；不支持时自动回退单步（不 500）。详见 docs/LLM-PROVIDERS.md §5。
# RST_AGENTIC_INVESTIGATE=0        # 设 0 关闭 agentic，回退单步
# RST_AGENTIC_MAX_STEPS=6          # 最大检索轮数（1–20）
# RST_AGENTIC_SIZE_CAP=20          # 单次 es_search 返回条数上限（1–200）
# RST_AGENTIC_DEADLINE_S=180       # 整体墙钟时限（秒），默认 180；设 0 关闭
# RST_AGENTIC_TOKEN_BUDGET=0       # 累计 token 软上限，0=不限；按成本预算设
# 提示：agentic 默认开启时，护栏依赖 RST_INDEX_WHITELIST，生产务必同时设置。

# 审计日志：每次 /api/* 调用写一条到客户 ES。默认关闭（保持 Gateway 对客户 ES 只读）
# 开启时需要 Gateway 的 ES 用户对审计索引有写权限
# RST_AUDIT_ENABLED=true
# RST_AUDIT_INDEX=.rst_copilot_audit

# v1.0.1 审计多通道转发——可选，独立配置，每个 sink 失败都不阻塞业务
# Syslog（RFC 5424）— UDP 514 / TCP 6514，按客户 SIEM 接入要求
# RST_AUDIT_SYSLOG_URL=udp://siem.customer.local:514
# Generic webhook — 可选 headers 用分号分隔（K1:V1;K2:V2）
# RST_AUDIT_WEBHOOK_URL=https://soar.customer.local/ingest/rst-copilot
# RST_AUDIT_WEBHOOK_HEADERS=Authorization:Bearer xxx;X-Source:rst-copilot
# 关闭 TLS 校验（仅自签名内网证书时用，生产慎用）
# RST_AUDIT_TLS_VERIFY=false

# v1.0.2 RAG 知识库（可选）——客户上传 Runbook / 字段字典让 explain/investigate 更准
# 不设 RST_EMBED_MODEL = RAG 关闭，KB 端点报错；augment_prompt 静默 no-op
# RST_EMBED_MODEL=ep-xxxxxxxxxxxxxx-xxxxx          # 火山方舟 embedding 接入点 ID
# RST_EMBED_MODEL=text-embedding-3-small           # OpenAI / Azure OpenAI
# RST_EMBED_MODEL=text-embedding-v2                # 阿里通义
# RST_EMBED_DIM=1536  # 必须严格匹配模型实际输出维度
                      # OpenAI text-embedding-3-small=1536；3-large=3072
                      # Doubao embedding=2048；通义 v2=1536

# ============================================================================
# 定时报告 + 飞书投递（可选）—— 日报/周报/月报自动生成并转发到飞书群
# ============================================================================
# 1) 定时生成：不设 = 关闭；报告归档到 ES(.rst_copilot_reports)
# RST_REPORT_SCHEDULE=daily,weekly,monthly
# RST_REPORT_TRIAGE_INDEX=.alerts-security.alerts-default   # 报告内含告警分诊时设
#
# 2) 飞书投递：目标(机器人 webhook + 密钥 + 绑定周期/阈值)在前端「报告投递」页配置，
#    加密存 ES。以下仅为运行参数：
# RST_PUBLIC_BASE_URL=https://copilot.customer.local   # 卡片「查看完整报告」按钮链接前缀
# RST_SECRET_KEY=                # Fernet 密钥(urlsafe base64 32B)。不设则自动生成
#                                # 并存 .rst_secret_key 文件。轮换会使已存密钥失效需重填
# RST_NOTIFY_WORKER_INTERVAL_SECONDS=15   # 投递 worker 轮询间隔(默认 15，最小 5)

# ============================================================================
# 实时告警同步（可选）—— 把 Elastic/Kibana 检测告警实时拉进本产品
# ============================================================================
# 源A：轮询尾随告警索引(范围+游标)。不设 = 关闭。8.x 用 .alerts-security.alerts-*，
#      7.x 用 .siem-signals-*。索引须在 RST_INDEX_WHITELIST 白名单内。
# RST_ALERT_INGEST_INDEX=.alerts-security.alerts-default
# RST_ALERT_INGEST_INTERVAL_SECONDS=10    # 轮询间隔(默认 10，最小 3)=准实时延迟下限
#
# 源B：Kibana Webhook Connector 主动推送到 POST /api/alerts/ingest。
#      不设密钥 = 端点禁用(403)。Kibana 侧在 connector 里加静态头
#      X-RST-Alert-Token: <此密钥> ；本端常量时间比对。
#      这条路径不吃登录/SSO 闸(connector 拿不到会话 cookie)，但**共享密钥闸照旧**：
#      配了 RST_GATEWAY_SHARED_SECRET 的话，connector 还要再加一个静态头
#      X-RST-Gateway-Token: <共享密钥>，否则 401。
# RST_ALERT_WEBHOOK_SECRET=
