# Project-root .env.example — used by the full-stack `docker compose up` here.
# Copy to .env and fill in. (Dev mode at poc/.env is a separate file used when
# running uvicorn locally.)
#
# CONTRACT — this file is also read by deploy/rst-reconcile.sh on every upgrade:
# an uncommented `KEY=value` whose value is non-empty is treated as a SAFE
# DEFAULT and appended verbatim to the customer's .env when the key is missing;
# an empty `KEY=` is treated as required and fails the update closed until the
# operator fills it. So placeholder examples belong in the COMMENT, never in the
# value — `LLM_API_KEY=your_ark_api_key` here meant a customer .env missing that
# key was silently "repaired" with the literal string your_ark_api_key.

# ─── LLM (Volcengine Ark / OpenAI / Ollama / vLLM — OpenAI-compatible API) ──────
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 火山方舟填 endpoint id,如 ep-xxxxxxxxxxxxxx-xxxxx
LLM_MODEL=
# LLM_TIMEOUT_S=180        # per-call LLM timeout (s); raise if investigate /
#                          # triage / report calls time out
# ─── 推理强度（思考模型：豆包 / GPT-5 / Claude / Qwen3 / Gemini 2.5 …）────────
# 网关按任务定要不要让模型「先想再答」：起标题 / 想角度 / 挑索引不想，NL→DSL 少想，
# 告警分诊 / 调查 / 检测规则才想。下面几个只在要偏离默认时才设。
# LLM_REASONING=auto              # auto | off | low | high —— 这个 provider 的覆盖，
#                                 # off = 所有任务都不推理（模型慢得难受时），high = 都推理
# RST_NL2DSL_REASONING=low        # 智能查询 NL→DSL 这一步：none | low | high | native
# RST_LLM_FIRST_TOKEN_TIMEOUT_S=45 # 生成查询时正文首字的硬上限（秒），超时中止并提示重试；0 = 不限
# RST_EMBED_COOLDOWN_S=60         # embedding 端点失败后冷却多久（秒）再试，期间提问不等它

# ─── Auth — SET BOTH IN PRODUCTION ─────────────────────────────────────────────
# RST_GATEWAY_SHARED_SECRET gates every /api/* call (callers send it in the
#   X-RST-Gateway-Token header). Leave empty ONLY for an isolated dev box.
# RST_ADMIN_TOKEN gates config-mutating endpoints (settings / providers).
#   If empty, those are accepted only from 127.0.0.1.
# NOTE: the browser SPA cannot send the shared secret itself — when it is set,
#   front the gateway with a reverse proxy that injects the header (see docs).
RST_GATEWAY_SHARED_SECRET=
RST_ADMIN_TOKEN=

# ─── Login (single operator) — CHANGE THE PASSWORD ────────────────────────────
# The product ships usable: /v2/login accepts  admin / Admin@123 . That password
# is in the docs, so until you replace it anyone who can reach this gateway can
# log in. The gateway logs a warning on every start until you do.
#
# Generate a hash — never put the plaintext here:
#   docker compose exec gateway python -m backend.session_auth 'your-password'
# then paste the output into RST_ADMIN_PASSWORD_HASH. Changing it also signs out
# every session that is currently open.
#
# Machine callers (ops curl, CI) do NOT log in — they send X-RST-Admin-Token with
# the RST_ADMIN_TOKEN value above and skip the session check.
#
# Ignored when RST_SSO_ENABLED is on: SSO owns identity, and two answers to
# "who is this" is worse than one.
RST_ADMIN_PASSWORD_HASH=
RST_ADMIN_USERNAME=admin
RST_SESSION_TTL_HOURS=12

# ─── Multi-user (enterprise) ────────────────────────────────────────────────
# Empty = one account, the two vars above. Set it and the gateway keeps
# accounts and roles in that Postgres instead: on first start it creates the
# table and seeds RST_ADMIN_USERNAME / RST_ADMIN_PASSWORD_HASH as the first
# administrator, so an existing single-operator install upgrades without
# anyone inventing new credentials. There is no migration step and no other
# schema; the table is created if it is missing.
#
# It must be a database this product owns. Do NOT point it at the customer's
# Elasticsearch or at an application database you do not control — the gateway
# writes accounts there, and the read-only promise about customer ES stands.
#
# docker-compose.prod.yml carries a `userdb` service for customers who have no
# Postgres of their own; set RST_USER_DB_PASSWORD and start it alongside the
# gateway. Back that volume up — it holds the accounts.
#
# Three roles, fixed: admin (everything, including user management), analyst
# (everything except user management and the other admin-only endpoints),
# viewer (read-only — every non-GET request is refused, apart from logging in,
# logging out and changing their own password).
RST_USER_DB_URL=
RST_USER_DB_USER=rst
RST_USER_DB_PASSWORD=
RST_USER_DB_NAME=rst_users

# Until RST_ADMIN_PASSWORD_HASH is set, the gateway refuses logins that do not
# come from the machine it runs on: the shipped password is in the manual, so a
# reachable port plus the factory credential is an open door. Set the hash above
# — that is the fix. Set this to 1 only for a LAN trial that genuinely wants the
# documented password; it has no effect once a hash is configured.
RST_ALLOW_DEFAULT_PASSWORD=

# Personal state (history / prefs / saved queries) written before the gateway
# knew who anyone was lives in a shared bucket. The configured account still
# reads it, so nothing appears to vanish on upgrade; writes always go to the
# named bucket, so each item migrates the first time it is touched. Set to 0
# once you are satisfied everything has moved.
RST_SHARED_BUCKET_FALLBACK=


# Cross-origin access. Empty = off, which is correct for every normal install:
# the gateway serves the SPA itself, so the browser is already same-origin.
# Only set this (comma-separated origins) if you host the front-end somewhere
# else. Never "*" — that lets any site on the internet read this API's responses.
RST_CORS_ORIGINS=

# Where audit events may be POSTed (运营 → 设置 → audit.webhook_url). Those
# events name the operator, the indices touched and the action taken, so the
# destination matters. Comma-separated host patterns, fnmatch syntax:
#   RST_AUDIT_WEBHOOK_ALLOWLIST=siem.corp.example,*.internal
# Set it and nothing else is accepted. Left empty, only loopback and link-local
# are refused (169.254.169.254 is the cloud metadata endpoint) — ordinary
# private ranges stay allowed because that is where an on-prem SIEM lives.
RST_AUDIT_WEBHOOK_ALLOWLIST=

# ─── License (rst-platform license server, v0.4.0 online-activation) ───────────
# The app public key ships in the image at poc/keys/license_public.pem — no
# config needed. LICENSE_SERVER_URL defaults to the production server below;
# override only to point at a local / staging license server.
LICENSE_SERVER_URL=https://license.reallysec.com

# ─── Elasticsearch / Kibana ────────────────────────────────────────────────────
# The prod stack (docker-compose.prod.yml) connects to the customer's EXISTING
# Elasticsearch — it ships no ES.
#
# Leaving these blank is fine: an admin can set the connection from the web UI
# (系统设置 → Elasticsearch 连接), which tests it before saving and stores it in
# settings.yml on the state volume. That overlay WINS over anything set here, so
# a value in this file is the initial/fallback connection, not the final word.
# e.g. https://es.corp.local:9200
ES_URL=
# ES auth — ES 8.x usually has security enabled, so set these. Kept COMMENTED:
# an ES without auth legitimately has neither, and an uncommented empty key
# would fail-close every future upgrade in rst-reconcile.sh (see CONTRACT above).
# ES_USER=rst_copilot_gateway
# ES_PASSWORD=
# Kibana is OPTIONAL — only used for "在 Kibana 中打开" deep-links. Leave blank
# to disable. Point at the customer Kibana the analyst's browser can reach.
# KIBANA_URL=https://kibana.corp.local:5601
# Need a self-contained PoC WITH bundled ES + Kibana? Use poc/docker-compose.yml
# (the dev stack), not the prod compose.
#
# When KIBANA_URL is an internal docker hostname (kibana:5601), set
# KIBANA_PUBLIC_URL to the host the analyst's browser can reach. Without
# this, "在 Kibana 中打开" deep-links return an unresolvable host.
# KIBANA_PUBLIC_URL=http://copilot.corp.local:5601
#
# When the customer ES uses HTTPS:
# RST_ES_VERIFY_CERTS=false                 # DEFAULT IS true (verify the ES server
#                                           # certificate). Self-signed / private CA:
#                                           # point RST_ES_CA_CERT at the CA instead of
#                                           # turning verification off.
# RST_ES_CA_CERT=/certs/es-ca.pem           # custom CA bundle (implies verify)
# RST_ES_TIMEOUT_S=30                        # per-request ES timeout (s); slow cluster -> raise
# RST_ES_MAX_RETRIES=2                       # transparent retries on timeout/conn error
# RST_ES_MAX_POOL_SIZE=                      # connections per node (blank = client default)
# RST_INDEX_WHITELIST=logs-*,filebeat-*     # restrict queryable indices
#                          # (security control); empty = all indices allowed
# --- multi-turn conversation memory ---
# RST_CONVERSATION_BACKEND=es               # prod compose default = es (persist to
#                          # .rst_copilot_conversations; survives restart, shared across
#                          # workers). `memory` = in-process only (lost on restart, 1h idle)
# RST_CONVERSATION_INDEX=.rst_copilot_conversations
# RST_CONVERSATION_TTL_DAYS=7               # idle expiry for ES-stored conversations
# --- response cache (cuts duplicate LLM/ES cost; in-process, per worker) ---
# RST_DSL_CACHE_TTL_S=600                    # cache identical NL->DSL generations; 0 = off
# RST_FIELD_DICT_CACHE_TTL_S=300             # cache field-dictionary scans; 0 = off

# ─── Online update (P4) ────────────────────────────────────────────────────────
# Gateway image tag the prod compose runs. Leave unset for a fresh install
# (compose defaults to the shipped version); rst-update.sh writes + updates this
# on a health-gated release install / rollback. Do not hand-edit while an update
# is in flight.
# GATEWAY_IMAGE_TAG=1.1.0

# ─── Quotas / runtime tuning ───────────────────────────────────────────────────
RST_TRIAL_DAILY_LIMIT=200
# Gateway container resource ceiling (prod compose). Size to the host.
# RST_GATEWAY_CPUS=2
# RST_GATEWAY_MEM=2g
# Per-IP rate limits (requests/minute) — defaults shown. Raise for a larger
# team behind one shared NAT egress IP; lower to cap LLM spend.
# RST_RATELIMIT_GENERATE=30
# RST_RATELIMIT_EXECUTE=30
# RST_RATELIMIT_KIBANA_LINK=120
# RST_MASKING_MODE=cloud   # force cloud / private / airgapped; default = license-derived
# RST_EMBED_MODEL=         # embedding model id — REQUIRED to use the RAG
#                          # knowledge base (/api/kb/*); provider-specific id
# RST_EMBED_BASE_URL=      # embedding endpoint, when different from LLM_BASE_URL
#                          # (Ark coding/v3 serves chat only — RAG needs this)
# RST_EMBED_DIM=1536       # embedding vector dimension; must match the model

# ─── 审计 / 索引生命周期(默认全关) ─────────────────────────────────────────────
# 审计日志(安全产品建议开):记录登录/查询/设置变更到 ES 索引 .rst_copilot_audit。
# RST_AUDIT_ENABLED=true
# 审计索引默认**无限增长**。开了审计就该同时开 ILM,否则磁盘只涨不降。
# RST_ILM_BOOTSTRAP=1 在启动时建 ILM 策略 + 索引模板(默认关,不改动既有部署)。
# RST_ILM_BOOTSTRAP=1
# RST_AUDIT_RETENTION_DAYS=180   # 审计索引保留天数,仅在 ILM 打开时生效

# ─── 定时巡检(默认全关 —— 不设这两个变量就永远不会自动跑) ─────────────────────
# 运营报表定时生成。csv,取值 daily / weekly / monthly;空 = 关。
# RST_REPORT_SCHEDULE=daily,weekly
# RST_REPORT_WEBHOOK_URL=                  # 每份报表 POST 到这里(可选)
# RST_REPORT_WEBHOOK_HEADERS=              # "K1:V1;K2:V2"
# RST_REPORT_PERSIST=0                     # 0 = 不写 ES 归档(默认写)
# RST_REPORT_INDEX=.rst_copilot_reports
# RST_REPORT_CHECK_INTERVAL_SECONDS=1800   # 调度 tick;< 60 视为误配,回落 1800
# RST_REPORT_TZ=+08:00                     # 报告周期边界所在时区;不设则跟随 RST_TIMEZONE(1.1.19 起,之前是 UTC)

# 提示词里「当前时间」和日界所在的时区(默认 UTC)。**国内部署必设 +08:00**：
# 不设的话「今天下午」「昨天」「8月8号」这类问题会按 UTC 切日界,查出来是空的
# 或者是错的一天 —— 现场真出过一次(prompts.py 的 _now_line 注释里有记录)。
# 与 RST_REPORT_TZ 是两件事:那个管报告周期边界,这个管模型怎么理解"今天"。
# RST_TIMEZONE=+08:00
# RST_REPORT_CATCHUP_MAX=7                 # 停机期间最多补跑几个周期(0 = 不补跑)
# 安全基线巡检轮询间隔(秒)。>= 300 才生效;不设 = 关,基线只能手工触发。
# 与客户 osquery pack 的 interval 对齐即可(如每天 86400)。
# RST_BASELINE_INTERVAL_SECONDS=86400
# 数据新鲜度窗口(小时,默认 48)。osquery 数据超过这个年龄就判 stale ——
# 不按陈旧数据判 pass/fail。客户 pack 跑得比 24h 慢,就调到 interval 的 2 倍以上。
# RST_BASELINE_MAX_AGE_HOURS=48
# 主机花名册窗口(天,默认 30)。这么久没上报过任何数据的主机不再枚举
# (退役机器不该永远排队)。窗口内但数据陈旧的主机仍会出现并判 stale。
# RST_BASELINE_HOST_ROSTER_DAYS=30
#
# 基线用到两个索引,方向相反 —— 一个读客户的,一个写我们的。改索引名时对着
# 这两行看,别只改一个:
#   读:客户 osquery 结果索引(Fleet 的 Osquery Manager 建的 data stream)
# RST_BASELINE_OSQUERY_INDEX=logs-osquery_manager.result-*
#   写:我们自己的判定结果(还有 baseline-rules / baseline-runs 两个同族的)
# RST_BASELINE_RESULTS_INDEX=baseline-results
# RST_BASELINE_RULES_INDEX=baseline-rules
# RST_BASELINE_RUNS_INDEX=baseline-runs
# 注:读的那个原名 RST_BASELINE_RESULT_INDEX(跟写的那个只差一个 s),旧名还认,
# 但会在日志里提醒改名。

# ─── Real-time alerts (optional — feeds /v2/alerts) ─────────────────────────────
# Source A (pull): the gateway tails a Kibana/ES detection-alerts index. Point at
# the read alias (NOT the .internal.* backing indices), e.g.
#   RST_ALERT_INGEST_INDEX=.alerts-security.alerts-default
# The ES_USER account must have read on .alerts-security.alerts-* (+ the
# .internal.alerts-security.alerts-* backing indices). Cold start pulls the last
# hour, then tails by cursor. Leave blank to disable.
# RST_ALERT_INGEST_INDEX=
# RST_ALERT_INGEST_INTERVAL_SECONDS=10
# Source B (push): shared secret Kibana's webhook connector sends as the
# X-RST-Alert-Token header. Generate with: openssl rand -hex 32
# Blank = webhook ingest disabled (POST /api/alerts/ingest returns 403).
# The connector cannot hold a session cookie, so this one path is exempt from the
# login / SSO-enforce gate — it authenticates with the token above instead. The
# SHARED-SECRET gate still applies: with RST_GATEWAY_SHARED_SECRET set, the
# connector must ALSO send X-RST-Gateway-Token or every push gets a 401.
# RST_ALERT_WEBHOOK_SECRET=
# One push can carry up to 200 alerts and each costs one LLM call (the summary).
# These bound that: how many are processed at once, and how long the batch may
# spend on summaries before the rest are stored WITHOUT one (never dropped —
# a connector that times out re-sends the whole batch, which costs far more).
# RST_ALERT_INGEST_CONCURRENCY=4
# RST_ALERT_INGEST_BUDGET_S=20

# ─── /metrics scrape token (optional) ──────────────────────────────────────────
# /metrics is not under /api/*, so neither the shared secret nor the login gate
# covers it: on a LAN deployment without Caddy in front, anyone who can reach the
# port can read route usage and license state. Set this and the scrape must send
# it as X-RST-Metrics-Token (or Authorization: Bearer). RST_ADMIN_TOKEN is
# accepted too. Unset = open, which is what shipped before.
# RST_METRICS_TOKEN=

# ─── Enterprise SSO (optional — uses the separate docker-compose.sso.yml) ───────
# OIDC / SAML / AD-LDAP login — full setup in docs/SSO.md. The SSO compose sets
# these gateway-side vars; listed here for reference:
#   RST_SSO_ENABLED=true              # frontend shows the logged-in user + logout
#   RST_SSO_ENFORCE=true              # gated /api/* must carry a verified identity
#   RST_RBAC_ADMIN_GROUPS=soc-admins  # IdP groups granted admin access (RBAC)
#   RST_RBAC_ANALYST_GROUPS=soc-l1,soc-l2   # groups mapped to the analyst role
#   RST_RBAC_VIEWER_GROUPS=auditors         # groups mapped to read-only
#
# Under SSO the IdP owns the accounts, so roles come from groups rather than
# from RST_USER_DB_URL. A user in several mapped groups gets the highest role.
# A user in none of them gets no role — allowed to write, not allowed to
# administer, which is what this product did before roles existed. Name a group
# in RST_RBAC_VIEWER_GROUPS to actually enforce read-only.

# ─── Production reverse proxy (docker-compose.prod.yml + Caddy) ─────────────────
# Hostname or IP analysts use to reach the appliance (REQUIRED for the prod
# stack). Multiple allowed, space-separated. Analysts open  https://<this>/v2/
# e.g. copilot.corp.local
CADDY_SITE_ADDRESS=
# Login is the gateway's own /v2 form (no Caddy Basic Auth). The default account
# is admin / Admin@123, which is published — change it in production via
# RST_ADMIN_PASSWORD_HASH (see the auth section near the top of this file).
